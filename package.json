{
  "name": "guff-api",
  "version": "1.0.0",
  "private": true,
  "description": "Guff: real-time team chat API (Express, Socket.IO, MongoDB)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "setup": "npm run build && node dist/scripts/setup.js",
    "db:reset": "npm run build && node dist/scripts/setup.js --reset",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@socket.io/mongo-adapter": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "jose": "^6.2.14",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
