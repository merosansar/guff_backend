# Copy to .env, or just run "npm run setup", which creates .env for you.
NODE_ENV=development
PORT=4100
# A local MongoDB, or your MongoDB Atlas connection string (mongodb+srv://user:password@cluster.../)
MONGODB_URI="mongodb://127.0.0.1:27017"
# Guff keeps everything in this one database, so it can share a cluster with other apps.
MONGODB_DB=guff
CORS_ORIGIN=http://localhost:5176
# At least 32 random characters. "npm run setup" generates one.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
MAX_UPLOAD_MB=10
AUTH_RATE_LIMIT=30
# Demo teammates answer DMs and @mentions while nobody is signed in as them. Set false for a real team.
DEMO_REPLIES=true
# memory = one API process. mongo = several processes share real-time events (needs a replica set, e.g. Atlas).
SOCKET_ADAPTER=memory

# ---- Optional features. Everything works without these; each line turns one up. ----

# The website's public address, used for links in emails and webhook URLs (defaults to CORS_ORIGIN).
APP_URL=
# Password-reset and verification emails go through Resend (resend.com, free tier). Without a key,
# the email (with its link) is printed in the API window instead.
RESEND_API_KEY=
MAIL_FROM=Guff <onboarding@resend.dev>
# Show a title and picture for the first link in a message.
LINK_PREVIEWS=true
# "Catch me up" AI summaries. Without a key the button is hidden.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Calls use a free public STUN server. Add a TURN server for networks that block direct connections:
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
ICE_SERVERS=
# Web push keys. Leave empty: Guff makes a pair once and keeps it in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@guff.local
