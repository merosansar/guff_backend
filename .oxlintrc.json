{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-async-endpoint-handlers": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}
